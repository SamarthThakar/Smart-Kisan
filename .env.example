# ===================================
# SMART KISAN — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ===================================

# --- DATABASE ---
# Development (SQLite - zero setup, just works)
DATABASE_URL=sqlite:///./smart_kisan.db
# Production PostgreSQL (Supabase/Render/etc.) - uncomment when deploying
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/smart_kisan_db

# --- JWT Authentication ---
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_32_CHAR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google Gemini API (Free AI Chatbot) ---
# Get your FREE key at: https://aistudio.google.com/app/apikey
# No credit card needed for development
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# --- Weather API (Open-Meteo) ---
# NO API KEY NEEDED — Open-Meteo is free and open source
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# --- Market Price API (Government of India) ---
# Register FREE at: https://data.gov.in
# After login: Resources > Daily Market Prices > Get API Access
DATA_GOV_API_KEY=REPLACE_WITH_DATA_GOV_API_KEY
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- ML Model Paths (relative to backend/) ---
DISEASE_MODEL_PATH=../models/disease_model.keras
DISEASE_CLASSES_PATH=../models/class_names.json
CROP_MODEL_PATH=../models/crop_model.joblib
CROP_SCALER_PATH=../models/crop_scaler.joblib
CROP_ENCODER_PATH=../models/crop_label_encoder.joblib
CHROMA_DB_PATH=../models/chroma_db

# --- File Upload Settings ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./uploads

# --- CORS (Frontend URL) ---
# Development
FRONTEND_URL=http://localhost:5173
# Production (uncomment and set your Vercel URL)
# FRONTEND_URL=https://smart-kisan.vercel.app

# --- Application ---
APP_NAME=Smart Kisan
APP_VERSION=1.0.0
DEBUG=true
